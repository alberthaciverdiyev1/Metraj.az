# Dependencies
/vendor/
/node_modules/

# Environment & Sensitive files
.env
.env.backup
.env.production
*.key
*.pem

# Laravel Storage & Cache
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*

# Public assets & uploads
/public/build/
/public/hot
/public/storage/
/storage/app/public/*

# IDE and OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing & Coverage
.phpunit.result.cache
/coverage/
.pest/

# Backups & Archives
*.zip
*.tar.gz
*.sql
*.sqlite

# Claude-specific exclusions (CLAUDE.md is the single source of truth)
# ARCHITECTURE.md köhnəlib — CLAUDE.md ilə ziddiyyət yaratmamaq üçün oxunmur
ARCHITECTURE.md
# Digər AI tool konfiqurasiyası (Gemini) Claude üçün lazım deyil
.geminiignore

# Git internals
.git/
